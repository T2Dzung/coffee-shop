apiVersion: v1
kind: PersistentVolume
metadata:
  name: go-modules-cache-pv
spec:
  capacity:
    storage: 10Gi
  volumeMode: Filesystem
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  nfs:
    path: /mnt/go-cache
    server: "{{ nfs_server_private_ip }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: go-modules-cache-pvc
  namespace: dev-ci
spec:
  storageClassName: ""
  volumeName: go-modules-cache-pv
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 10Gi
