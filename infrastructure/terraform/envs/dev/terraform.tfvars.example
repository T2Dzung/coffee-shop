project_name            = "coffeeshop"
environment             = "dev"
aws_region              = "ap-southeast-1"
cluster_name            = "coffeeshop-dev"
dev_runtime_enabled     = false
node_count              = 3
k3s_instance_type       = "t3.large"
k3s_root_volume_size    = 80
pinned_ami_id            = "ami-xxxxxxxxxxxxxxxxx"
haproxy_instance_type    = "t3.micro"
haproxy_root_volume_size = 20
longhorn_data_volume_size = 50
key_name                = "your-key-pair-name"
admin_cidrs             = ["1.2.3.4/32"]
