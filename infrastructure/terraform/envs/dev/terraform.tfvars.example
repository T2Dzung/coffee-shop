project_name            = "coffeeshop"
environment             = "dev"
aws_region              = "ap-southeast-1"
expected_aws_account_id = "123456789012"
cluster_name            = "coffeeshop-dev"
github_repository       = "REPLACE_WITH_GITHUB_OWNER/REPOSITORY"
# Managed by `platformctl dev setup|teardown`; do not toggle manually.
node_count              = 3
k3s_instance_type       = "t3.large"
k3s_root_volume_size    = 30
# Optional: null selects the latest Canonical Ubuntu 24.04 AMI at plan time.
# Set an explicit AMI ID only when the rehearsal requires a reproducible image pin.
pinned_ami_id            = null
haproxy_instance_type    = "t3.micro"
haproxy_root_volume_size = 20
longhorn_data_volume_size = 50
key_name                = "your-key-pair-name"
admin_cidrs             = ["1.2.3.4/32"]
