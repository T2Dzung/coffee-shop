# Legacy reference only. This file is intentionally outside the active ArgoCD
# application path because the Ingress API is frozen and no nginx controller is
# installed. Phase 2 replaces it with Cilium Gateway API + HTTPRoute resources.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: coffeeshop-ingress
  namespace: coffeeshop
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web
                port:
                  number: 8888
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: proxy
                port:
                  number: 5000
